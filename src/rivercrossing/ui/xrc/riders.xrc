<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rider editor + CSV import preview (spec.md 15b file map,
  xrc-windows.md section C). Control names are frozen; tests find them
  with FindWindowByName and tools/gen_ids.py turns them into ui/ids.py
  (R-05, R-73).

  Measured on wxPython 4.3.1 / wxWidgets 3.3.3 (tools/toolkit_probe.py):

    * wxDataViewListCtrl cannot be authored here: its XRC handler
      hard-forces the control name to "dataviewCtrl". riders_list and
      conflicts_list are wxDataViewCtrl, whose name IS honoured;
      columns and rows are appended in code with a
      DataViewIndexListModel subclass (canvas code-side item 1).
    * XRC has no minsize property for windows - only for sizeritem and
      wxSplitterWindow (wxWidgets src/xrc/xmlres.cpp SetupWindow).
      Neither dialog has a documented minimum, so neither declares a
      <size>: the sizer handler then Fit()s the dialog and applies
      SetSizeHints(). Code re-applies SetMinSize() if a screen-fit
      minimum is ever specified.

  Code-side per the canvas footnotes: riders_list rows, and its Team
  column hidden in a solo-only ride; team_choice contents (teams stay
  editable until start for relay rides, during the ride for pooled
  ones); delete_btn disabled until a row is selected and, once the
  entry has data, forever - after the start it is DNF/void only
  (R-15); the W7 rework draws the editor at 1280x560 (riders.xrc's
  own minsize note above: the code-side SetMinSize() floor applies
  width AND height now) with Delete + Close anchoring the list pane's
  bottom; summary_lbl text and conflicts_list rows; csv_preview_dlg's
  wxID_OK disabled while conflicts > 0. The File-menu Import/Export
  Riders CSV routes stay the one CSV path (W7 removed this editor's
  import_btn/export_btn; their shared flows still live code-side in
  ui/views/rider_editor.py for those routes).

  1.0.12: rider_editor_dlg's Rider box is a read-only display now -
  plate_input/first_name_input/last_name_input carry wxTE_READONLY
  and team_choice is a wxChoice (selectable, never free-typed), so
  the pane shows the selected record while all writing happens in
  add_rider_dlg. That dialog carries both modes: XRC titles it "Add
  Rider" and labels its wxID_OK "Save", and the view retitles it
  "Edit Rider" for the Edit mode (one window, one primary button).
  Its wxID_OK width floor and the editor's 1280x560 floor are
  code-side (a window has no XRC minsize).
-->
<resource>

  <object class="wxDialog" name="rider_editor_dlg">
    <title>Rider Editor</title>
    <!-- R-05 requires resizable windows; the in-app text zoom (90-150%)
         cannot work in a fixed-size dialog. spec.md 13 says "dialogs
         fixed-size" - recorded conflict, resolved in favour of R-05. -->
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxHORIZONTAL</orient>

      <!-- W7 rework: the riders list pane takes 3/5 of the width and
           the form pane 2/5 (sizer options 3:2), matching the canvas
           redraw at 1280px: the list is the editor's dominant pane.
           rider_search lands above riders_list in the later W7
           search slice; Delete + Close anchor the pane's bottom. -->
      <object class="sizeritem">
        <option>3</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>

          <!-- W7 search: rider_search narrows riders_list by name or
               plate (the audit_dlg precedent's own shape: a label +
               wxSearchCtrl row above the list). -->
          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxStaticText">
                  <label>Search</label>
                </object>
              </object>
              <object class="sizeritem">
                <option>1</option>
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxSearchCtrl" name="rider_search"/>
              </object>
            </object>
          </object>

          <object class="sizeritem">
            <option>1</option>
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxDataViewCtrl" name="riders_list"/>
          </object>

          <!-- Delete sits bottom-left under riders_list with Close
               beside it, equal-sized (W7 rework): the standard-dialog
               sizer pattern cannot stretch stock buttons, so Close is
               a plain stock-id button like library.xrc's wxID_DELETE;
               dialogs.wire_close_button still finds it by name and
               wires Escape. Delete stays disabled until a row is
               selected (code-side set_delete_enabled). -->
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND|wxRIGHT</flag>
                <border>6</border>
                <object class="wxButton" name="delete_btn">
                  <label>Delete</label>
                </object>
              </object>
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND</flag>
                <object class="wxButton" name="wxID_CLOSE"/>
              </object>
            </object>
          </object>

        </object>
      </object>

      <object class="sizeritem">
        <option>2</option>
        <flag>wxEXPAND|wxTOP|wxRIGHT|wxBOTTOM</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxStaticBoxSizer">
              <label>Rider</label>
              <orient>wxVERTICAL</orient>

              <object class="sizeritem">
                <flag>wxEXPAND|wxBOTTOM</flag>
                <border>8</border>
                <object class="wxFlexGridSizer">
                  <cols>2</cols>
                  <vgap>6</vgap>
                  <hgap>8</hgap>
                  <growablecols>1</growablecols>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Plate</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="plate_input">
                      <style>wxTE_READONLY</style>
                    </object>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>First name</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="first_name_input">
                      <style>wxTE_READONLY</style>
                    </object>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Last name</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="last_name_input">
                      <style>wxTE_READONLY</style>
                    </object>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Team</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="team_choice">
                      <style>wxTE_READONLY</style>
                    </object>
                  </object>

                </object>
              </object>

            </object>
          </object>

          <!-- 1.0.12: the Rider box above is display-only, so the
               pane's two buttons anchor its bottom-right: Edit
               Rider… acts on the record shown above them, Add
               rider… opens the blank dialog. Both use plain custom
               ids (never wxID_OK), so wx never auto-closes on a
               click and dialogs.run_dialog's stock-id wiring leaves
               them alone. -->
          <object class="sizeritem">
            <flag>wxALIGN_RIGHT|wxTOP</flag>
            <border>8</border>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <flag>wxRIGHT|wxALIGN_CENTRE_VERTICAL</flag>
                <border>6</border>
                <object class="wxButton" name="edit_btn">
                  <label>Edit Rider…</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxButton" name="add_btn">
                  <label>Add rider…</label>
                </object>
              </object>
            </object>
          </object>

        </object>
      </object>

    </object>
  </object>

  <!-- W7/1.0.12: the dedicated Add Rider dialog, which the editor's
       add_btn opens in this, its blank, mode. The editor's own form
       became a read-only display, so edit_btn opens the very same
       window in its Edit Rider… mode: the view retitles it and pairs
       EditRiderPresenter with it (the title here is the Add default).
       Control names reuse the editor's own (plate_input etc.: each
       top-level window is its own name namespace, tools/gen_ids.py's
       rule), so the ids constants stay shared; the read-only styles
       do NOT: this dialog is where the operator types. The Team row's
       visibility follows entry_mode like the editor's (code-side);
       refusals show on a code-side infobar (add_rider_infobar,
       wxInfoBar: XRC cannot author one). -->
  <object class="wxDialog" name="add_rider_dlg">
    <title>Add Rider</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>

      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxStaticBoxSizer">
          <label>Rider</label>
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxFlexGridSizer">
              <cols>2</cols>
              <vgap>6</vgap>
              <hgap>8</hgap>
              <growablecols>1</growablecols>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Plate</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="plate_input"/>
              </object>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>First name</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="first_name_input"/>
              </object>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Last name</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="last_name_input"/>
              </object>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Team</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxChoice" name="team_choice"/>
              </object>

              <!-- Phase 3: the Sex dropdown (blank = unset, then M
                   and F). The three items are set in code, in
                   views/rider_editor.AddRiderDialog, since XRC
                   authors an empty wxChoice. -->
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Sex</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxChoice" name="sex_choice"/>
              </object>

            </object>
          </object>

        </object>
      </object>

      <!-- wxID_OK carries the "Save" label, one label for both modes
           since the same click commits either an add or an edit. The
           stock id keeps the button on the platform-correct side and
           Enter safe; the view floors its width in code, 3x the
           label's own best width (XRC has no window minsize). -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxStdDialogButtonSizer">
          <object class="button">
            <object class="wxButton" name="wxID_OK">
              <label>Save</label>
            </object>
          </object>
          <object class="button">
            <object class="wxButton" name="wxID_CANCEL"/>
          </object>
        </object>
      </object>

    </object>
  </object>

  <object class="wxDialog" name="csv_preview_dlg">
    <title>Import Riders — Preview</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>

      <!-- "riders.csv → 178 riders · 12 teams · 3 conflicts": one line
           built in code from the parsed file. -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxStaticText" name="summary_lbl">
          <label></label>
        </object>
      </object>

      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxDataViewCtrl" name="conflicts_list"/>
      </object>

      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT</flag>
        <border>10</border>
        <object class="wxStaticText">
          <label>Nothing is written until you import. Re-import freely reshapes teams before start.</label>
        </object>
      </object>

      <!-- Phase 3: the explicit opt-in that maps blank AND
           unrecognized non-blank SEX cells to "M" on import. It sits
           unchecked; the operator chooses it deliberately. -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxCheckBox" name="map_unknown_sex_chk">
          <label>Map unknown sex to Male</label>
        </object>
      </object>

      <!-- Phase E: the DRAFT-only opt-in that reshapes a team group of
           exactly one rider into a solo entry on import. Unchecked by
           default, like the sex mapping above. -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxCheckBox" name="convert_teams_of_one_chk">
          <label>Convert teams of 1 to solo</label>
        </object>
      </object>

      <!-- wxID_OK carries the canvas's "Import" label; the stock id is
           what keeps the button on the platform-correct side. -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxStdDialogButtonSizer">
          <object class="button">
            <object class="wxButton" name="wxID_OK">
              <label>Import</label>
            </object>
          </object>
          <object class="button">
            <object class="wxButton" name="wxID_CANCEL"/>
          </object>
        </object>
      </object>

    </object>
  </object>

  <object class="wxDialog" name="rider_issues_dlg">
    <title>Check for Rider Issues</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>

      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxStaticText" name="issues_summary_lbl">
          <label></label>
        </object>
      </object>

      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxDataViewCtrl" name="issues_list"/>
      </object>

      <!-- The two custom buttons sit in a sibling sizer next to the
           stock button sizer (teams.xrc's save_btn pattern), so they
           keep a real position instead of the (-1,-1) a
           wxStdDialogButtonSizer leaves custom buttons at. -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <option>1</option>
            <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
            <border>6</border>
            <object class="wxButton" name="open_editor_btn">
              <label>Open Editor…</label>
            </object>
          </object>
          <object class="sizeritem">
            <option>1</option>
            <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
            <border>6</border>
            <object class="wxButton" name="convert_solo_btn">
              <label>Convert to Solo</label>
            </object>
          </object>
          <object class="sizeritem">
            <option>1</option>
            <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
            <border>6</border>
            <object class="wxButton" name="assign_plate_btn">
              <label>Assign Plate</label>
            </object>
          </object>
          <object class="sizeritem">
            <option>1</option>
            <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
            <border>6</border>
            <object class="wxButton" name="renumber_btn">
              <label>Renumber</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxStdDialogButtonSizer">
              <object class="button">
                <object class="wxButton" name="wxID_CLOSE"/>
              </object>
            </object>
          </object>
        </object>
      </object>

    </object>
  </object>

  <!-- Phase 5: the console's blocked-start report. The one-line native
       warning W5 used could only ever show the engine's joined reason
       string; this dialog lists each blocking issue on its own row,
       with a single OK to dismiss (the ride stays un-started either
       way). Shape mirrors rider_issues_dlg above. -->
  <object class="wxDialog" name="start_blocked_dlg">
    <title>Cannot Start Ride</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>

      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxDataViewCtrl" name="start_blocked_list"/>
      </object>

      <object class="sizeritem">
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxStdDialogButtonSizer">
          <object class="button">
            <object class="wxButton" name="wxID_OK">
              <label>OK</label>
            </object>
          </object>
        </object>
      </object>

    </object>
  </object>

</resource>
