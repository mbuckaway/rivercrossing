<?xml version="1.0" encoding="UTF-8"?>
<!--
  Teams editor (spec.md 15b file map, xrc-windows.md section C),
  reworked: two Team | Riders columns, a read-only record form, a
  multi-line Notes box, ~50/50 panes, and the action buttons at each
  pane's bottom (Add team on the right pane's bottom, Edit/Remove/
  Close on the left pane's).
  Control names are frozen; tests find them with FindWindowByName and
  tools/gen_ids.py turns them into ui/ids.py (R-05, R-73).

  Measured on wxPython 4.3.1 / wxWidgets 3.3.3 (tools/toolkit_probe.py):

    * wxDataViewListCtrl cannot be authored here: its XRC handler
      hard-forces the control name to "dataviewCtrl". teams_list and
      members_list are wxDataViewCtrl, whose name IS honoured;
      columns and rows are appended in code with a
      DataViewIndexListModel subclass (canvas code-side item 1).
      teams_list's Team | Riders headers, their sortable flag and the
      rider-count cells live there, never in this file.
    * wxInfoBar cannot be authored here either (the handler yields a
      generic wx.Control and drops the name), so teams_infobar is
      built code-side with SetName(), mirroring rider_editor_dlg's
      roster_infobar pattern.
    * XRC has no minsize property for windows - only for sizeritem
      and wxSplitterWindow (wxWidgets src/xrc/xmlres.cpp SetupWindow).
      The dialog declares none, so the sizer handler Fit()s it and
      applies SetSizeHints(); code re-applies SetMinSize() with the
      editor's own MIN_SIZE floor (the same rider_editor_dlg shape).

  Phase 3's rework makes the editor a read-only record display: the
  name/relay-plate/notes inputs are wxTE_READONLY (their values are
  rendered from the selected team, never typed into), the Logo column,
  the logo_bmp preview and the Pick card / Image / Remove logo buttons
  are gone, and Save left the left pane for the Add/Edit Team dialog
  (edit_btn opens it on the selected team; add_btn opens it blank).
  Code-side per the canvas footnotes: teams_list/members_list rows and
  columns; the Plate (relay) row's team_relay-only visibility (hidden
  on a rider_pooled ride, whose teams derive their plate from their
  members); notes_input's three-line minimum height (this file authors
  only its wxTE_MULTILINE style; the pixel floor is font-metric and
  lives code-side); members_list's bounded height (SetMinSize
  code-side: the Members box below does not grow with the dialog, so a
  long member list scrolls inside it while teams_list takes the extra
  height).
-->
<resource>

  <object class="wxDialog" name="team_editor_dlg">
    <title>Teams Editor</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxHORIZONTAL</orient>

      <!-- Left pane: the teams list + Edit/Remove/Close row. The two
           panes share the width (option 1 each) so the two list
           columns get their ~half of the dialog. -->
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxCheckBox" name="single_member_only_chk">
              <label>Only show one-rider teams</label>
            </object>
          </object>

          <object class="sizeritem">
            <option>1</option>
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxDataViewCtrl" name="teams_list"/>
          </object>

          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <!-- Edit/Remove/Close sit bottom-left: edit_btn is
                   enabled only while a team is selected (its own
                   record is edited in add_team_dlg, so the editor
                   has no in-place Save), Remove keeps its own slot,
                   and wxID_CLOSE follows in its stock sizer. The
                   Close sizer item shares the same option=1 as
                   Edit/Remove so the stock button stretches to their
                   size. -->
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND|wxRIGHT</flag>
                <border>6</border>
                <object class="wxButton" name="edit_btn">
                  <label>Edit…</label>
                </object>
              </object>
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND|wxRIGHT</flag>
                <border>6</border>
                <object class="wxButton" name="remove_btn">
                  <label>Remove</label>
                </object>
              </object>
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND</flag>
                <object class="wxStdDialogButtonSizer">
                  <object class="button">
                    <object class="wxButton" name="wxID_CLOSE"/>
                  </object>
                </object>
              </object>
            </object>
          </object>

        </object>
      </object>

      <!-- Right pane: the read-only record form, the members list and
           Add team at the pane's bottom. -->
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxTOP|wxRIGHT|wxBOTTOM</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxStaticBoxSizer">
              <label>Team</label>
              <orient>wxVERTICAL</orient>

              <object class="sizeritem">
                <flag>wxEXPAND|wxBOTTOM</flag>
                <border>8</border>
                <object class="wxFlexGridSizer">
                  <cols>2</cols>
                  <vgap>6</vgap>
                  <hgap>8</hgap>
                  <growablecols>1</growablecols>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Name</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="name_input">
                      <style>wxTE_READONLY</style>
                    </object>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Plate (relay)</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="relay_plate_input">
                      <style>wxTE_READONLY</style>
                    </object>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Notes</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="notes_input">
                      <style>wxTE_MULTILINE|wxTE_READONLY</style>
                    </object>
                  </object>

                </object>
              </object>

            </object>
          </object>

          <!-- Members box: not growable - its height is bounded
               code-side (members_list.SetMinSize) so a long member
               list scrolls inside it instead of stretching the
               dialog; the dialog's extra height goes to teams_list
               on the left pane. -->
          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxStaticBoxSizer">
              <label>Members (read-only)</label>
              <orient>wxVERTICAL</orient>
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND</flag>
                <object class="wxDataViewCtrl" name="members_list"/>
              </object>
            </object>
          </object>

          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <!-- Add team anchors the right pane's bottom: it opens
                   add_team_dlg (its own Add dialog) instead of
                   adding from this form, which is read-only now. -->
              <object class="spacer">
                <option>1</option>
                <size>0,0</size>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxButton" name="add_btn">
                  <label>Add team…</label>
                </object>
              </object>
            </object>
          </object>

        </object>
      </object>

    </object>
  </object>

  <!-- The dedicated Add/Edit Team dialog. The editor's add_btn opens
       it blank and edit_btn (or a row double-click) opens it on the
       selected team (the W7 add_rider_dlg shape): a zero-rider team
       entry is created and its riders join later through the Rider
       Editor, while the edit route writes the record back. Control
       names reuse the editor's own (name_input, notes_input,
       relay_plate_input, logo_bmp, pick_card_btn: each top-level
       window is its own name namespace, tools/gen_ids.py's rule), so
       the ids constants stay shared. The two modes' caption and
       button label are set code-side (Add Team/Add, Edit Team/Save);
       the Plate (relay) row's visibility follows plate_model like the
       editor's (code-side); refusals show on a code-side infobar
       (add_team_infobar, wxInfoBar: XRC cannot author one). -->
  <object class="wxDialog" name="add_team_dlg">
    <title>Add Team</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>

      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxStaticBoxSizer">
          <label>Team</label>
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxFlexGridSizer">
              <cols>2</cols>
              <vgap>6</vgap>
              <hgap>8</hgap>
              <growablecols>1</growablecols>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Name</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="name_input"/>
              </object>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Plate (relay)</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="relay_plate_input"/>
              </object>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Notes</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="notes_input">
                  <style>wxTE_MULTILINE</style>
                </object>
              </object>

            </object>
          </object>

          <!-- Logo row: pick the team's card logo before Add/Save.
               logo_bmp's bitmap is supplied in code (a card asset
               bitmap, or wx.NullBitmap for a blank state). -->
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>8</border>
                <object class="wxStaticText">
                  <label>Logo</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxStaticBitmap" name="logo_bmp"/>
              </object>
              <object class="spacer">
                <option>1</option>
                <size>0,0</size>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxButton" name="pick_card_btn">
                  <label>Pick card…</label>
                </object>
              </object>
            </object>
          </object>

        </object>
      </object>

      <!-- wxID_OK carries the "Add" label; the stock id keeps the
           button on the platform-correct side and Enter safe (the
           edit route relabels it "Save" code-side). -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxStdDialogButtonSizer">
          <object class="button">
            <object class="wxButton" name="wxID_OK">
              <label>Add</label>
            </object>
          </object>
          <object class="button">
            <object class="wxButton" name="wxID_CANCEL"/>
          </object>
        </object>
      </object>

    </object>
  </object>

</resource>
