<?xml version="1.0" encoding="UTF-8"?>
<!--
  Teams editor (spec.md 15b file map, xrc-windows.md section C),
  reworked: three Team | Riders | Logo columns, a real-bitmap logo
  preview above the members list, a multi-line Notes box, ~50/50
  panes, and the action buttons at each pane's bottom (Add team on
  the right pane's bottom, Save/Remove/Close on the left pane's).
  Control names are frozen; tests find them with FindWindowByName and
  tools/gen_ids.py turns them into ui/ids.py (R-05, R-73).

  Measured on wxPython 4.3.1 / wxWidgets 3.3.3 (tools/toolkit_probe.py):

    * wxDataViewListCtrl cannot be authored here: its XRC handler
      hard-forces the control name to "dataviewCtrl". teams_list and
      members_list are wxDataViewCtrl, whose name IS honoured;
      columns and rows are appended in code with a
      DataViewIndexListModel subclass (canvas code-side item 1).
      teams_list's Team | Riders | Logo headers and the rider-count
      cells live there, never in this file.
    * wxInfoBar cannot be authored here either (the handler yields a
      generic wx.Control and drops the name), so teams_infobar is
      built code-side with SetName(), mirroring rider_editor_dlg's
      roster_infobar pattern.
    * XRC has no minsize property for windows - only for sizeritem
      and wxSplitterWindow (wxWidgets src/xrc/xmlres.cpp SetupWindow).
      The dialog declares none, so the sizer handler Fit()s it and
      applies SetSizeHints(); code re-applies SetMinSize() with the
      editor's own MIN_SIZE floor (the same rider_editor_dlg shape).

  Code-side per the canvas footnotes and the rework: teams_list/
  members_list rows and columns; the Plate (relay) row's
  team_relay-only visibility (hidden on a rider_pooled ride, whose
  teams derive their plate from their members); logo_bmp's bitmap
  (a card asset bitmap or the picked PNG's decode; a blank state is
  wx.NullBitmap). The wxStaticBitmap shell is declared here with no
  <bitmap>, like about_logo_bmp; notes_input's three-line minimum
  height (this file authors only its wxTE_MULTILINE style; the
  pixel floor is font-metric and lives code-side);
  members_list's bounded height (SetMinSize code-side: the Members
  box below does not grow with the dialog, so a long member list
  scrolls inside it while teams_list takes the extra height);
  pick_card_btn/image_btn handlers.
-->
<resource>

  <object class="wxDialog" name="team_editor_dlg">
    <title>Teams Editor</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxHORIZONTAL</orient>

      <!-- Left pane: the teams list + Save/Remove/Close row. The two
           panes share the width (option 1 each) so the three list
           columns get their ~half of the dialog. -->
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxCheckBox" name="single_member_only_chk">
              <label>Only show one-rider teams</label>
            </object>
          </object>

          <object class="sizeritem">
            <option>1</option>
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxDataViewCtrl" name="teams_list"/>
          </object>

          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <!-- Save/Remove/Close sit bottom-left (rework): Save
                   replaces the old Add team slot, Remove keeps its
                   own, and wxID_CLOSE follows in its stock sizer
                   (the teams.xrc save_btn/riders.xrc sibling-sizer
                   pattern for stock-adjacent custom buttons). -->
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND|wxRIGHT</flag>
                <border>6</border>
                <object class="wxButton" name="save_btn">
                  <label>Save</label>
                </object>
              </object>
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND|wxRIGHT</flag>
                <border>6</border>
                <object class="wxButton" name="remove_btn">
                  <label>Remove</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxStdDialogButtonSizer">
                  <object class="button">
                    <object class="wxButton" name="wxID_CLOSE"/>
                  </object>
                </object>
              </object>
            </object>
          </object>

        </object>
      </object>

      <!-- Right pane: the record/Add form, the logo preview above the
           members list, and Add team at the pane's bottom. -->
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxTOP|wxRIGHT|wxBOTTOM</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxStaticBoxSizer">
              <label>Team</label>
              <orient>wxVERTICAL</orient>

              <object class="sizeritem">
                <flag>wxEXPAND|wxBOTTOM</flag>
                <border>8</border>
                <object class="wxFlexGridSizer">
                  <cols>2</cols>
                  <vgap>6</vgap>
                  <hgap>8</hgap>
                  <growablecols>1</growablecols>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Name</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="name_input"/>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Plate (relay)</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="relay_plate_input"/>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_VERTICAL</flag>
                    <object class="wxStaticText">
                      <label>Notes</label>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <object class="wxTextCtrl" name="notes_input">
                      <style>wxTE_MULTILINE</style>
                    </object>
                  </object>

                </object>
              </object>

            </object>
          </object>

          <!-- Logo preview row: the bitmap (logo_bmp) is supplied in
               code - a card asset bitmap, the picked PNG's decode,
               or wx.NullBitmap for a blank state. It sits directly
               above the members list (rework). -->
          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>8</border>
                <object class="wxStaticText">
                  <label>Logo</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxStaticBitmap" name="logo_bmp"/>
              </object>
              <object class="spacer">
                <option>1</option>
                <size>0,0</size>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxButton" name="pick_card_btn">
                  <label>Pick card…</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxButton" name="image_btn">
                  <label>Image…</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxLEFT</flag>
                <border>6</border>
                <object class="wxButton" name="remove_logo_btn">
                  <label>Remove logo</label>
                </object>
              </object>
            </object>
          </object>

          <!-- Members box: not growable - its height is bounded
               code-side (members_list.SetMinSize) so a long member
               list scrolls inside it instead of stretching the
               dialog; the dialog's extra height goes to teams_list
               on the left pane. -->
          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxStaticBoxSizer">
              <label>Members (read-only)</label>
              <orient>wxVERTICAL</orient>
              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND</flag>
                <object class="wxDataViewCtrl" name="members_list"/>
              </object>
            </object>
          </object>

          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <!-- Add team anchors the right pane's bottom (rework):
                   the form above it is the selected team's record
                   editor. W8 relabelled the button and made it open
                   add_team_dlg (its own Add dialog) instead of
                   adding from this form. -->
              <object class="spacer">
                <option>1</option>
                <size>0,0</size>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxButton" name="add_btn">
                  <label>Add team…</label>
                </object>
              </object>
            </object>
          </object>

        </object>
      </object>

    </object>
  </object>

  <!-- W8: the dedicated Add Team dialog. The editor's add_btn opens
       this window instead of adding from the editor's own form (the
       W7 add_rider_dlg shape): a zero-rider team entry is created
       and its riders join later through the Rider Editor. Control
       names reuse the editor's own (name_input, notes_input,
       relay_plate_input, logo_bmp, pick_card_btn, image_btn: each
       top-level window is its own name namespace, tools/gen_ids.py's
       rule), so the ids constants stay shared. The Plate (relay)
       row's visibility follows plate_model like the editor's
       (code-side); refusals show on a code-side infobar
       (add_team_infobar, wxInfoBar: XRC cannot author one). -->
  <object class="wxDialog" name="add_team_dlg">
    <title>Add Team</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>

      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxStaticBoxSizer">
          <label>Team</label>
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>8</border>
            <object class="wxFlexGridSizer">
              <cols>2</cols>
              <vgap>6</vgap>
              <hgap>8</hgap>
              <growablecols>1</growablecols>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Name</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="name_input"/>
              </object>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Plate (relay)</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="relay_plate_input"/>
              </object>

              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>Notes</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <object class="wxTextCtrl" name="notes_input">
                  <style>wxTE_MULTILINE</style>
                </object>
              </object>

            </object>
          </object>

          <!-- Logo row: pick the new team's card or image logo before
               Add. logo_bmp's bitmap is supplied in code (a card
               asset bitmap, the picked PNG's decode, or wx.NullBitmap
               for a blank state), the same seam the editor uses. -->
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>8</border>
                <object class="wxStaticText">
                  <label>Logo</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxStaticBitmap" name="logo_bmp"/>
              </object>
              <object class="spacer">
                <option>1</option>
                <size>0,0</size>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxButton" name="pick_card_btn">
                  <label>Pick card…</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxButton" name="image_btn">
                  <label>Image…</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxLEFT</flag>
                <border>6</border>
                <object class="wxButton" name="remove_logo_btn">
                  <label>Remove logo</label>
                </object>
              </object>
            </object>
          </object>

        </object>
      </object>

      <!-- wxID_OK carries the "Add" label; the stock id keeps the
           button on the platform-correct side and Enter safe. -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxStdDialogButtonSizer">
          <object class="button">
            <object class="wxButton" name="wxID_OK">
              <label>Add</label>
            </object>
          </object>
          <object class="button">
            <object class="wxButton" name="wxID_CANCEL"/>
          </object>
        </object>
      </object>

    </object>
  </object>

</resource>
