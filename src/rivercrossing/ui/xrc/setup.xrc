<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ride Setup dialog (spec.md 15b file map, xrc-windows.md section B) - the 22
  frozen controls the canvas annotates, plus the stock wxID_OK / wxID_CANCEL
  row in a wxStdDialogButtonSizer so button order is right on both platforms.

  Radio defaults are drawn on the canvas and required by spec.md 13 ("radio
  groups always have a default"): always_deal_radio (short-lap policy,
  W4), mixed_radio (teams) and pooled_radio start selected. wxRB_GROUP
  opens each of the three groups - short-lap card policy, entry mode
  and plate model - and <value>1</value> is honoured by XRC (measured:
  tools/toolkit_probe.py check_xrc_names).

  Phase 1 re-shaped the jokers-per-deck group: the jokers_0/2/4_radio
  trio became one wxChoice (jokers_choice) over 0..4, opening on 1
  (<selection>1</selection>; measured honoured, like <content>'s item
  list). Phase 5 re-shaped it again, to the shipped pair of controls:
  jokers_spin (a wxSpinCtrl over 0..10, <value>1</value>) beside the
  jokers_per_deck_radio / jokers_total_radio pair, which answers "do
  those jokers come back every shuffle?" - per-deck re-deals them each
  cycle, total (the checked default, jokers_total_radio) spends them
  once per ride. spec.md 13's "radio groups always have a default" is
  why the pair carries one; jokers_spin's own <value> keeps the same
  rule for the count. ride.py's DEFAULT_JOKERS_PER_DECK /
  DEFAULT_JOKERS_MODE are those same two defaults, recorded so the
  controls and the domain cannot drift.

  Phase 5 also replaced the cap_chk + cap_spin pair with one cap_choice
  dropdown: "Disabled" (the default selection, no cap at all) and then
  one item per cap 5..20. A single control cannot express the retired
  pair's "checkbox off, spinner holding a stale number" state, so the
  dialog can no longer submit a cap the operator did not choose.

  Code-side per the canvas footnote: field values are loaded from the ride
  record (this file declares structure and ranges only); the entry-mode and
  plate-model groups lock after start for relay rides and stay editable for
  pooled ones (R-17); tiebreak_list rows and their reorder are persisted.

  Plan sections 3c/3d reshaped the Cards box: the standalone Logo row's
  wxFilePickerCtrl is retired, tiebreak_list carries its own bounded
  160x120 box, and the logo column (preview bitmap, status label, Browse…
  button) sits beside it. The staged PNG itself is code-side: the view
  resizes the browsed file into LOGO_STANDARD_SIZE, writes the copy to a
  temp file and previews it.

  Ranges: max riders per team has documented bounds (spec.md 1 and 2 -
  2 to 10, default 4), jokers_spin's own <min>/<max> fix its 0..10 set
  (Phase 5), and cap_choice's item list fixes 5..20. decks_spin gets a
  floor of 1 and no ceiling; lap_km_spin gets one decimal, matching the
  canvas's "8.0". Everything else is validated in code.
-->
<resource>

  <object class="wxDialog" name="ride_setup_dlg">
    <title>Ride Setup</title>
    <!-- R-05 requires resizable windows; the in-app text zoom (90-150%)
         cannot work in a fixed-size dialog. spec.md 13 says "dialogs
         fixed-size" - recorded conflict, resolved in favour of R-05. -->
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>

    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>

      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
            <border>8</border>
            <object class="wxStaticText">
              <label>Name</label>
            </object>
          </object>
          <object class="sizeritem">
            <option>1</option>
            <flag>wxEXPAND</flag>
            <object class="wxTextCtrl" name="name_input"/>
          </object>
        </object>
      </object>

      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxFlexGridSizer">
          <cols>4</cols>
          <vgap>6</vgap>
          <hgap>8</hgap>
          <growablecols>1,3</growablecols>

          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL</flag>
            <object class="wxStaticText">
              <label>Date</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxDatePickerCtrl" name="date_picker"/>
          </object>
          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL</flag>
            <object class="wxStaticText">
              <label>Planned start</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxTimePickerCtrl" name="start_time_picker"/>
          </object>

          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL</flag>
            <object class="wxStaticText">
              <label>Venue</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxTextCtrl" name="venue_input"/>
          </object>
          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL</flag>
            <object class="wxStaticText">
              <label>Lap length km</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxSpinCtrlDouble" name="lap_km_spin">
              <digits>1</digits>
              <inc>0.1</inc>
            </object>
          </object>

          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL</flag>
            <object class="wxStaticText">
              <label>Organizer</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxTextCtrl" name="organizer_input"/>
          </object>
          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL</flag>
            <object class="wxStaticText">
              <label>Scorer</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxTextCtrl" name="scorer_input"/>
          </object>

          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL</flag>
            <object class="wxStaticText">
              <label>Duration (H:MM)</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxTextCtrl" name="duration_input"/>
          </object>
          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL</flag>
            <object class="wxStaticText">
              <label>Min lap (M:SS)</label>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <object class="wxTextCtrl" name="min_lap_input"/>
          </object>

        </object>
      </object>

      <!-- W4 short-lap card policy: a fourth radio pair beside the lap
           fields. always_deal_radio is the declared default (a fresh
           dialog always deals short-lap cards; holding them for review
           is the operator's explicit choice, ride_config.hold_short_laps).
           wxRB_GROUP on hold_short_radio opens the pair's own group so
           the radios created later (solo/mixed, pooled/relay,
           jokers_0/2/4) never join it. -->
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
            <border>8</border>
            <object class="wxRadioButton" name="hold_short_radio">
              <label>Hold short-lap cards for review</label>
              <style>wxRB_GROUP</style>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxALIGN_CENTRE_VERTICAL|wxLEFT</flag>
            <border>8</border>
            <object class="wxRadioButton" name="always_deal_radio">
              <label>Always deal cards</label>
              <value>1</value>
            </object>
          </object>
        </object>
      </object>

      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxStaticBoxSizer">
          <label>Entries</label>
          <orient>wxVERTICAL</orient>

          <object class="sizeritem">
            <flag>wxBOTTOM</flag>
            <border>4</border>
            <object class="wxRadioButton" name="solo_radio">
              <label>Solo riders only</label>
              <style>wxRB_GROUP</style>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxBOTTOM</flag>
            <border>4</border>
            <object class="wxRadioButton" name="mixed_radio">
              <label>Solo + teams (default)</label>
              <value>1</value>
            </object>
          </object>

          <object class="sizeritem">
            <flag>wxLEFT|wxBOTTOM</flag>
            <border>20</border>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>8</border>
                <object class="wxStaticText">
                  <label>Max riders per team</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>8</border>
                <object class="wxSpinCtrl" name="team_size_spin">
                  <min>2</min>
                  <max>10</max>
                  <value>4</value>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxStaticText">
                  <label>(2–10)</label>
                </object>
              </object>
            </object>
          </object>

          <object class="sizeritem">
            <flag>wxEXPAND|wxLEFT|wxBOTTOM</flag>
            <border>20</border>
            <object class="wxRadioButton" name="pooled_radio">
              <label>Rider plates — pooled (default): each rider draws per lap, uncapped; team hand from pooled cards</label>
              <style>wxRB_GROUP</style>
              <value>1</value>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND|wxLEFT</flag>
            <border>20</border>
            <object class="wxRadioButton" name="relay_radio">
              <label>Team plate — relay: one plate per team, one rider on course (EPIC)</label>
            </object>
          </object>

        </object>
      </object>

      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>10</border>
        <object class="wxStaticBoxSizer">
          <label>Cards</label>
          <orient>wxVERTICAL</orient>

          <!-- Phase 5's Cards controls: the joker count, the per-deck /
               total mode pair (total checked, ride.DEFAULT_JOKERS_MODE),
               and the card cap dropdown. The cap's "Disabled" item is
               the uncapped default; the view reads the item's own text,
               so the numbers 5..20 are domain values, not indices. -->
          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>6</border>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxStaticText">
                  <label>Decks</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>14</border>
                <object class="wxSpinCtrl" name="decks_spin">
                  <min>1</min>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxStaticText">
                  <label>Jokers</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>14</border>
                <object class="wxSpinCtrl" name="jokers_spin">
                  <min>0</min>
                  <max>10</max>
                  <value>1</value>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxRadioButton" name="jokers_per_deck_radio">
                  <label>Per deck</label>
                  <style>wxRB_GROUP</style>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxRadioButton" name="jokers_total_radio">
                  <label>Total</label>
                  <value>1</value>
                </object>
              </object>
            </object>
          </object>

          <object class="sizeritem">
            <flag>wxEXPAND|wxBOTTOM</flag>
            <border>6</border>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL|wxRIGHT</flag>
                <border>6</border>
                <object class="wxStaticText">
                  <label>Card cap</label>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALIGN_CENTRE_VERTICAL</flag>
                <object class="wxChoice" name="cap_choice">
                  <content>
                    <item>Disabled</item>
                    <item>5</item>
                    <item>6</item>
                    <item>7</item>
                    <item>8</item>
                    <item>9</item>
                    <item>10</item>
                    <item>11</item>
                    <item>12</item>
                    <item>13</item>
                    <item>14</item>
                    <item>15</item>
                    <item>16</item>
                    <item>17</item>
                    <item>18</item>
                    <item>19</item>
                    <item>20</item>
                  </content>
                  <selection>0</selection>
                </object>
              </object>
            </object>
          </object>

          <!-- Rows and their order come from the ride's tiebreak_order
               (spec.md 5); the control supplies the reorder arrows.
               The list carries its own bounded 160x120 box (the view
               floors it at the same size): full-width, the reorder
               control stretched to the whole dialog and pushed the
               logo column out of the Cards box.

               The logo column (plan section 3d) replaces the retired
               standalone Logo row's wxFilePickerCtrl. logo_preview_bmp
               is authored with no bitmap child (measured on wxPython
               4.3.1, XRC yields a real wxStaticBitmap that keeps its
               name and accepts SetBitmap later, ride_logo_bmp's own
               authored shape), and logo_status_lbl declares the "NO
               LOGO" default a fresh dialog shows until one is staged
               through logo_browse_btn's native PNG picker. -->
          <object class="sizeritem">
            <option>1</option>
            <flag>wxEXPAND</flag>
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>

              <object class="sizeritem">
                <option>1</option>
                <flag>wxEXPAND</flag>
                <object class="wxEditableListBox" name="tiebreak_list">
                  <label>Tie-break order</label>
                  <size>160,120</size>
                </object>
              </object>

              <object class="sizeritem">
                <flag>wxLEFT</flag>
                <border>8</border>
                <object class="wxBoxSizer">
                  <orient>wxVERTICAL</orient>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_HORIZONTAL</flag>
                    <object class="wxStaticBitmap" name="logo_preview_bmp">
                      <size>96,96</size>
                    </object>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_HORIZONTAL|wxTOP</flag>
                    <border>4</border>
                    <object class="wxStaticText" name="logo_status_lbl">
                      <label>NO LOGO</label>
                    </object>
                  </object>

                  <object class="sizeritem">
                    <flag>wxALIGN_CENTRE_HORIZONTAL|wxTOP</flag>
                    <border>4</border>
                    <object class="wxButton" name="logo_browse_btn">
                      <label>Browse…</label>
                    </object>
                  </object>

                </object>
              </object>

            </object>
          </object>

        </object>
      </object>

      <object class="sizeritem">
        <flag>wxEXPAND|wxALL</flag>
        <border>10</border>
        <object class="wxStdDialogButtonSizer">
          <object class="button">
            <!-- D2: the stock id stays wxID_OK so wx keeps its
                 platform button order and default handling; only the
                 visible text changes, and it changes for both modes
                 (New Ride commits a new ride, Edit Ride saves an
                 existing one: both are a save). -->
            <object class="wxButton" name="wxID_OK">
              <label>Save</label>
            </object>
          </object>
          <object class="button">
            <object class="wxButton" name="wxID_CANCEL"/>
          </object>
        </object>
      </object>

    </object>
  </object>

</resource>
