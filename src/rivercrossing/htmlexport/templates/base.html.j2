{#- rivercrossing.htmlexport — page template (Spec §8, R-61).
    Rendered by htmlexport.render(ride, placed, opts) with:
      Environment(PackageLoader("rivercrossing.htmlexport", "templates"),
                  autoescape=True, undefined=StrictUndefined)
    Context (all required — StrictUndefined):
      event        EventInfo: kicker, title, meta, organizer, scorer, generated,
                   entries, laps, cards
      options      ExportOptions: show_times, laps_board, time_board, full_field,
                   all_cards, lap_km
      sections     Sections: the planned page sections — per-kind podiums,
                   top lists and laps boards plus the full-field teams/solo
                   partitions, and the derived team_plates set the "Fastest"
                   board blanks team rows' plates with (pdfexport's own
                   lookup). The template renders this plan; it never
                   slices rows itself.
      tie_note     str or None; rendered under each top-list table whose rows
                   include a tie
      logo_src     data: URI in production (base64); URL only in dev samples
      logo_alt     organizer name for the logo
      payload      the full record for the race-data block
      dev          False in production. True only when regenerating the design
                   samples: CDN Tailwind + Google Fonts stand-ins instead of the
                   vendored CSS/fonts.
      compiled_css / fonts_css  (production) CSS compiled once at package build
                   by the Tailwind CLI against this frozen template + the base64
                   Barlow/Barlow Condensed @font-face subsets. Trusted package
                   assets — the |safe values on the page, like racejson below.
    Filters: racejson = json.dumps(payload record) with every '</' escaped as
    '<\/' — the <script>-breakout guard, not an escaper — whose plain-text
    result the call site marks |safe. The <!-- j2: --> comments in the output
    name the emitting macro for traceability. Golden pages regenerate from this
    template only deliberately (Spec §8 tests). -#}
{% import "macros.html.j2" as m with context -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ event.title }} — Official Poker Run Results{% if not options.show_times %} (no times){% endif %}</title>
{% if dev -%}
<!-- Template emitted by rivercrossing.htmlexport (Spec §8).
     THIS SAMPLE previews with the Tailwind 4 browser build + Google Fonts (dev stand-ins).
     PRODUCTION: CSS is compiled once at package build (Tailwind CLI in CI against this
     frozen template) and vendored with base64 Barlow woff2 subsets; export injects the
     race JSON + logo into the prebuilt template — no Node, no CDN, fully offline.
     Markup is STATIC Jinja2 output (autoescape on, StrictUndefined): base.html.j2 +
     macros (event_header, podium_card, standings_row, team_standings_row, laps_board,
     time_board, field_row, team_field_row, drawn_row) render the whole page at export.
     No client-side rendering, zero script logic — the page works with JS disabled. The
     race-data block is the embedded machine-readable record (</ escaped as <\/,
     round-trip tested against the payload model); nothing reads it at runtime. Time
     cells are emitted only when show_times — absent markup, not hidden markup. Teams
     never render a plate anywhere: the section names the kind. Plain Tailwind
     utilities + frozen custom classes (.bp/.c/.chip/.t-col/.no-print); no component
     library. The "j2:" comments below name the emitting macro. -->
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;700&family=Barlow+Condensed:wght@400;600&display=swap" rel="stylesheet">
<style type="text/tailwindcss">
{% include "theme.css" %}
</style>
{%- else -%}
<!-- Generated by RiverCrossing (rivercrossing.htmlexport, Spec §8). Self-contained:
     vendored CSS + fonts inlined, logo embedded, zero script logic — works offline
     from file:// with JS disabled. The race-data block is the machine-readable
     record of these results; nothing reads it at runtime. -->
<style>{{ fonts_css | safe }}
{{ compiled_css | safe }}</style>
{%- endif %}
</head>
<body class="bg-paper text-ink font-body" style="background-color:#f2f2f3">
<div class="mx-auto max-w-5xl px-4 sm:px-8 py-8">

  {{ m.event_header(event, options, logo_src, logo_alt) }}

  <p class="mt-4 text-sm text-ink/60 max-w-2xl">It's not a race, it's a poker run — placings are by best poker hand. Lap counts{% if options.show_times %} and times{% endif %} below are unofficial and shown for bragging rights only.</p>

  <div class="mt-4 text-xs text-ink/50">{% if options.show_times %}Published with times — the organizer's export setting decides; there is no toggle on the page.{% else %}Published without times — the organizer's export setting decides; there is no toggle on the page, and no time data is embedded in it.{% endif %}</div>

{% set team_event = (sections.teams | length) > 0 %}
  <!-- Podium -->
{% if sections.podium_teams %}  <section class="mt-8">
    <h2 class="font-head font-semibold text-2xl uppercase tracking-wide">Best hands — teams</h2>
    <!-- j2: {% raw %}{% for r in sections.podium_teams %}{{ podium_card(r, options, false) }}{% endfor %}{% endraw %} -->
    <div class="mt-4 grid gap-5 sm:grid-cols-3">
{% for r in sections.podium_teams %}      {{ m.podium_card(r, options, false) }}
{% endfor %}    </div>
  </section>
{% endif %}{% if sections.podium_solo %}  <section class="mt-8">
    <h2 class="font-head font-semibold text-2xl uppercase tracking-wide">{{ 'Best hands — solo riders' if team_event else 'Best hands — top 3' }}</h2>
    <!-- j2: {% raw %}{% for r in sections.podium_solo %}{{ podium_card(r, options) }}{% endfor %}{% endraw %} -->
    <div class="mt-4 grid gap-5 sm:grid-cols-3">
{% for r in sections.podium_solo %}      {{ m.podium_card(r, options) }}
{% endfor %}    </div>
  </section>
{% endif %}

  <!-- Top lists -->
{% if sections.top_teams %}  <section class="mt-10">
    <h2 class="font-head font-semibold text-2xl uppercase tracking-wide">Top teams</h2>
    <div class="mt-3 overflow-x-auto"><table class="w-full text-sm tabular-nums">
      <thead><tr class="text-left text-[11px] uppercase tracking-[0.08em] text-ink/55 border-b border-ink/15">
        <th class="py-2 pr-3">Place</th><th class="py-2 pr-3">Entry</th><th class="py-2 pr-3">Laps</th>{% if options.show_times %}<th class="py-2 pr-3 t-col">Total time</th>{% endif %}<th class="py-2 pr-3">Best 5 cards</th><th class="py-2">Hand</th>
      </tr></thead>
      <tbody><!-- j2: {% raw %}{% for r in sections.top_teams %}{{ team_standings_row(r, options) }}{% endfor %}{% endraw %} -->
{% for r in sections.top_teams %}        {{ m.team_standings_row(r, options) }}
{% endfor %}      </tbody>
    </table></div>
    <!-- j2: {% raw %}{% if tie_note and (sections.top_teams | selectattr('tie') | list) %}{% endraw %} -->{% if tie_note and (sections.top_teams | selectattr('tie') | list) %}<p class="mt-2 text-xs text-ink/50">{{ tie_note }}</p>{% endif %}
  </section>
{% endif %}{% if sections.top_solo %}  <section class="mt-10">
    <h2 class="font-head font-semibold text-2xl uppercase tracking-wide">{{ 'Top solo riders' if team_event else 'Top ten' }}</h2>
    <div class="mt-3 overflow-x-auto"><table class="w-full text-sm tabular-nums">
      <thead><tr class="text-left text-[11px] uppercase tracking-[0.08em] text-ink/55 border-b border-ink/15">
        <th class="py-2 pr-3">Place</th><th class="py-2 pr-3">Plate</th><th class="py-2 pr-3">Entry</th><th class="py-2 pr-3">Laps</th>{% if options.show_times %}<th class="py-2 pr-3 t-col">Total time</th>{% endif %}<th class="py-2 pr-3">Best 5 cards</th><th class="py-2">Hand</th>
      </tr></thead>
      <tbody><!-- j2: {% raw %}{% for r in sections.top_solo %}{{ standings_row(r, options) }}{% endfor %}{% endraw %} -->
{% for r in sections.top_solo %}        {{ m.standings_row(r, options) }}
{% endfor %}      </tbody>
    </table></div>
    <!-- j2: {% raw %}{% if tie_note and (sections.top_solo | selectattr('tie') | list) %}{% endraw %} -->{% if tie_note and (sections.top_solo | selectattr('tie') | list) %}<p class="mt-2 text-xs text-ink/50">{{ tie_note }}</p>{% endif %}
  </section>
{% endif %}

  <!-- Optional leaderboards -->
  <div class="mt-10 grid gap-8 md:grid-cols-2">
{% if options.laps_board and sections.laps_teams %}    {{ m.laps_board(sections.laps_teams, options, 'Most laps — teams', false) }}
{% endif %}{% if options.laps_board and sections.laps_solo %}    {{ m.laps_board(sections.laps_solo, options, 'Most laps — solo riders' if team_event else 'Most laps', true) }}
{% endif %}{% if options.time_board and sections.time_board %}    {{ m.time_board(sections.time_board, sections.team_plates) }}
{% endif %}  </div>

{% if options.full_field %}  <!-- Full field -->
  <section class="mt-10">
    <h2 class="font-head font-semibold text-2xl uppercase tracking-wide">Full field</h2>
    <p class="text-xs text-ink/50 mt-1">Every entry, ordered by hand{% if team_event %} — teams ranked against teams, solo riders against solo riders{% endif %}. ★ = joker, shown as the card it played.{% if options.all_cards %} This export includes every card drawn (organizer option).{% endif %}</p>
{% if sections.teams %}    <h3 class="mt-6 font-head font-semibold text-xl uppercase tracking-wide">Teams</h3>
    <div class="mt-3 overflow-x-auto"><table class="w-full text-sm tabular-nums">
      <thead><tr class="text-left text-[11px] uppercase tracking-[0.08em] text-ink/55 border-b border-ink/15">
        <th class="py-2 pr-3">Place</th><th class="py-2 pr-3">Entry</th><th class="py-2 pr-3">Laps</th>{% if options.show_times %}<th class="py-2 pr-3 t-col">Total time</th><th class="py-2 pr-3 t-col">Best lap</th>{% endif %}<th class="py-2 pr-3">Cards</th><th class="py-2">Hand</th>
      </tr></thead>
      <tbody><!-- j2: {% raw %}{% for r in sections.teams %}{{ team_field_row(r, options) }}{% if options.all_cards %}{{ drawn_row(r, (5 if options.show_times else 3)) }}{% endif %}{% endfor %}{% endraw %} -->
{% for r in sections.teams %}        {{ m.team_field_row(r, options) }}{% if options.all_cards %}
        {{ m.drawn_row(r, (5 if options.show_times else 3)) }}{% endif %}
{% endfor %}      </tbody>
    </table></div>
{% endif %}{% if sections.solo %}    <h3 class="mt-6 font-head font-semibold text-xl uppercase tracking-wide">Solo riders</h3>
    <div class="mt-3 overflow-x-auto"><table class="w-full text-sm tabular-nums">
      <thead><tr class="text-left text-[11px] uppercase tracking-[0.08em] text-ink/55 border-b border-ink/15">
        <th class="py-2 pr-3">Place</th><th class="py-2 pr-3">Plate</th><th class="py-2 pr-3">Entry</th><th class="py-2 pr-3">Type</th><th class="py-2 pr-3">Laps</th>{% if options.show_times %}<th class="py-2 pr-3 t-col">Total time</th><th class="py-2 pr-3 t-col">Best lap</th>{% endif %}<th class="py-2">Best hand</th>
      </tr></thead>
      <tbody><!-- j2: {% raw %}{% for r in sections.solo %}{{ field_row(r, options) }}{% if options.all_cards %}{{ drawn_row(r, (6 if options.show_times else 4)) }}{% endif %}{% endfor %}{% endraw %} -->
{% for r in sections.solo %}        {{ m.field_row(r, options) }}{% if options.all_cards %}
        {{ m.drawn_row(r, (6 if options.show_times else 4)) }}{% endif %}
{% endfor %}      </tbody>
    </table></div>
{% endif %}  </section>
{% endif %}
  {{ m.footer(event) }}
</div>

<!-- ══ Embedded data record — the exact payload this page was rendered from
     (all scoring computed by the app; round-trip tested; </ escaped as <\/).
     The markup above is static Jinja2 output — nothing reads this block. ══ -->
<script type="application/json" id="race-data">{{ payload | racejson | safe }}</script>
</body>
</html>
