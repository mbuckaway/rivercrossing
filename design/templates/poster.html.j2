{#- rivercrossing.htmlexport — podium poster template (Spec §8, R-61).
    Rendered by htmlexport.render_poster(ride, placed, opts, logo_path=...,
    generated=...) through the same StrictUndefined, autoescaping
    Environment (and the same vendored assets) base.html.j2 renders from.
    Context (all required — StrictUndefined):
      event            EventInfo: the ride's own meta, organizer, scorer,
                       title and generated stamp
      options          ExportOptions: the export flags; only show_times
                       renders here (the poster shows no boards)
      poster_sections  (heading, rows) per section, in page order — the
                       per-kind top three on a team event, the top five with
                       no heading on a solo-only field. An empty row tuple
                       renders no section at all.
      logo_src         data: URI in production (base64); the transparent 1x1
                       fallback when the ride carries no logo, so the img
                       never holds an empty src (D8)
      logo_alt         organizer name for the logo
      compiled_css / fonts_css  the vendored package assets, inlined — the
                       |safe values on the page, like the results page's
      Cards are ["rank", suit] pairs with suit "j" for a joker; the chips
      macro takes the steel accent for hearts/diamonds/jokers (no red).
      Regenerate the goldens deliberately only (Spec §8 tests). -#}
{% import "macros.html.j2" as m with context -%}
{% macro poster_card(r, options) -%}
<div class="bp p-5 {{ 'bg-steel-800 text-paper' if r.place == 1 else 'bg-transparent' }}"><i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i><div class="flex items-baseline gap-3"><span class="font-head font-semibold text-5xl leading-none">{{ r.place }}</span><div class="min-w-0"><div class="font-head font-semibold text-xl leading-tight truncate">{% if r.type != 'TEAM' %}#{{ r.plate }} {% endif %}{{ r.entry }}</div><div class="text-xs {{ 'text-paper/70' if r.place == 1 else 'text-ink/55' }}">{{ 'Team' if r.type == 'TEAM' else 'Solo' }}{% if r.sex %} ({{ r.sex }}){% endif %} — {{ r.entry }} · {{ r.laps }} laps{% if options.show_times %} · {{ r.total }}{% endif %}</div></div></div><div class="mt-4">{{ m.chips(r.cards, big=true) }}</div><div class="mt-3 font-head font-semibold tracking-wide {{ 'text-steel-300' if r.place == 1 else 'text-steel-700' }}">{{ r.hand }}</div></div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ event.title }} — Podium poster</title>
<!-- Generated by RiverCrossing (rivercrossing.htmlexport, Spec §8). Self-contained:
     vendored CSS + fonts inlined, logo embedded, no script logic at all — works
     offline from file://. Each card names its place, entry, run, hand and best 5
     cards; teams never render a plate, their section names the kind. -->
<style>{{ fonts_css | safe }}
{{ compiled_css | safe }}</style>
</head>
<body class="bg-paper text-ink font-body" style="background-color:#f2f2f3">
<div class="mx-auto max-w-5xl px-4 sm:px-8 py-8">

  <header class="bp p-6 sm:p-8"><i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
    <div class="flex flex-wrap items-center gap-6">
      <img src="{{ logo_src }}" alt="{{ logo_alt }}" class="h-16 w-auto" id="poster-logo">
      <div class="min-w-0">
        <div class="font-head font-semibold uppercase tracking-[0.12em] text-steel-700 text-sm">{{ event.organizer }}</div>
        <p class="mt-1 text-sm text-ink/60">{{ event.meta }}</p>
        <h1 class="mt-2 font-head font-semibold text-4xl sm:text-5xl leading-none">Best poker hands</h1>
        <h2 class="mt-1 font-head font-semibold text-xl leading-tight">{{ event.title }}</h2>
      </div>
    </div>
  </header>

{% for heading, rows in poster_sections %}{% if rows %}  <section class="mt-8">
{% if heading %}    <h3 class="font-head font-semibold text-xl uppercase tracking-wide">{{ heading }}</h3>
{% endif %}    <div class="mt-4 grid gap-5 sm:grid-cols-3">
{% for r in rows %}      {{ poster_card(r, options) }}
{% endfor %}    </div>
  </section>
{% endif %}{% endfor %}
  {{ m.footer(event) }}
</div>
</body>
</html>
